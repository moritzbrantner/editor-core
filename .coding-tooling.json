{
  "schemaVersion": 1,
  "profile": "repository-foundation-v1",
  "tiers": {
    "fast": ["format:check", "lint", "typecheck", "build", "test:unit"],
    "full": [
      "format:check",
      "lint",
      "typecheck",
      "build",
      "test:unit",
      "test:integration",
      "test:e2e",
      "package:check",
      "benchmark:smoke"
    ]
  },
  "requiredCapabilities": ["format:check", "lint", "typecheck", "build", "test:unit"],
  "optionalCapabilities": ["test:integration", "test:e2e", "package:check", "benchmark:smoke"],
  "capabilityCommands": {
    "@moenarch/editor-core": {
      "package:check": [
        "bash",
        "-lc",
        "bun run build && bun run smoke:package && bun run pack:check"
      ],
      "benchmark:smoke": ["bun", "run", "bench:check"]
    }
  }
}
